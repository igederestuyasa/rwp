# ============================================================
# RWP Hutama Karya — Environment Variables
# ------------------------------------------------------------
# Salin ke web/.env.local lalu isi nilai aslinya:
#   cp web/.env.local.example web/.env.local
# JANGAN commit .env.local (sudah di .gitignore).
#
# NEXT_PUBLIC_* → dibaca saat BUILD dan ikut ke browser; tidak boleh berisi
#                 secret. Di Vercel, isi di Project Settings > Environment
#                 Variables SEBELUM build, lalu deploy ulang bila diubah.
# Lainnya       → hanya di server (Route Handler). Tidak pernah ke browser.
# ============================================================

# ===== Mode =====
# "true"  = data contoh di memori, tanpa backend (dev cepat, CI, demo).
# Selain "true" (termasuk kosong) = Supabase sungguhan. Di Vercel set "false".
NEXT_PUBLIC_USE_MOCK=true

# ===== Supabase (Dashboard > Project Settings > API) =====
# URL project TANPA /rest/v1/. Ikut menyusun Content-Security-Policy.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Anon key — aman di browser, RLS yang menjaga.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Service role key — MEM-BYPASS RLS. Hanya dipakai /api/policy-pdf di server.
# JANGAN diberi prefix NEXT_PUBLIC_, JANGAN commit.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ===== Sahabat RWP (asisten AI) — server saja =====
# Dipakai /api/asisten (jawaban) dan /api/korpus/ingest (embedding dokumen
# yang diunggah admin di halaman /korpus).
OPENAI_API_KEY=your-openai-key
OPENAI_CHAT_MODEL=gpt-4.1-mini
# ⚠️ Mengganti model embedding = seluruh korpus WAJIB diproses ulang dari /korpus.
OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1   # ganti bila lewat Azure/proxy

# ===== Storage =====
# Bucket privat dokumen kebijakan (PDF) dan berkas korpus asisten.
# Bucket bukti laporan (rwp-evidence) ditetapkan di kode, lihat lib/storage.ts.
POLICY_PDF_BUCKET=policy-docs

# ===== Dev opsional =====
# Alamat perangkat lain di jaringan lokal yang boleh membuka `next dev`.
# NEXT_PUBLIC_DEV_ORIGIN=192.168.0.10
