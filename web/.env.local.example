# ============================================================
# RWP Hutama Karya (Next.js) — Environment Variables
# ------------------------------------------------------------
# Copy file ini → web/.env.local lalu isi nilai aslinya.
# JANGAN commit .env.local ke git.
#   cp web/.env.local.example web/.env.local
#
# NEXT_PUBLIC_* → aman di sisi client (tidak mengandung secret).
# Yang lain     → server-side only (Next.js Route Handlers).
# ============================================================

# ===== Supabase =====
# Dapatkan dari: Supabase Dashboard > Project Settings > API

# URL project (aman di client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon key (aman di client — RLS tetap berlaku)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Service role key — HANYA untuk server-side (Route Handlers).
# MEM-BYPASS RLS. JANGAN taruh di NEXT_PUBLIC_* dan JANGAN commit.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here


# ===== LLM & Embedding (HCsisten / RAG) — server-side only =====
# Dipakai oleh: web/src/lib/llmClient.ts, /api/asisten, scripts/ingest.mjs
# Ganti model = ubah env di sini (kode tidak berubah).
# ⚠️ Ganti OPENAI_EMBED_MODEL = WAJIB re-ingest semua dokumen.

OPENAI_API_KEY=your-openai-key
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1   # ganti kalau pakai Azure/proxy

# -- Alternatif provider (kalau pindah, sesuaikan llmClient.ts) --
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=your-azure-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key


# ===== Storage =====
# Nama bucket Supabase Storage untuk bukti laporan & lampiran
SUPABASE_STORAGE_BUCKET=rwp-evidence

# Nama bucket privat untuk PDF dokumen kebijakan HC Policy
# File di bucket ini hanya bisa diakses via signed URL (server-side)
POLICY_PDF_BUCKET=policy-docs


# ===== Feature Flags =====
# true  = pakai data mock (mode development, tanpa backend)
# false = pakai Supabase (mode production)
NEXT_PUBLIC_USE_MOCK=true
