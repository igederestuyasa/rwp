# ============================================================
# RWP Hutama Karya — Environment Variables
# ------------------------------------------------------------
# Salin ke .env.local lalu isi nilai aslinya:
#   cp .env.local.example .env.local
# JANGAN commit .env.local (sudah di .gitignore).
#
# NEXT_PUBLIC_* → dibaca saat BUILD dan ikut ke browser; tidak boleh berisi
#                 secret. Di Vercel, isi di Project Settings > Environment
#                 Variables SEBELUM build, lalu deploy ulang bila diubah.
# Lainnya       → hanya di server (Route Handler). Tidak pernah ke browser.
# ============================================================

# ===== Mode =====
# "true"  = data contoh di memori, tanpa backend (dev cepat, CI, demo).
# Selain "true" (termasuk kosong) = Supabase sungguhan. Di Vercel set "false".
NEXT_PUBLIC_USE_MOCK=true

# ===== Supabase (Dashboard > Project Settings > API) =====
# URL project TANPA /rest/v1/. Ikut menyusun Content-Security-Policy.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Anon key — aman di browser, RLS yang menjaga.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Service role key — MEM-BYPASS RLS. Hanya dipakai di server oleh
# /api/policy-pdf dan /api/notifikasi/status.
# JANGAN diberi prefix NEXT_PUBLIC_, JANGAN commit.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ===== Sahabat RWP (asisten AI) — server saja =====
# Dipakai /api/asisten (jawaban) dan /api/korpus/ingest (embedding dokumen
# yang diunggah admin di halaman /korpus).
OPENAI_API_KEY=your-openai-key
OPENAI_CHAT_MODEL=gpt-4.1-mini
# ⚠️ Mengganti model embedding = seluruh korpus WAJIB diproses ulang dari /korpus.
OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=https://api.openai.com/v1   # ganti bila lewat Azure/proxy

# ===== Notifikasi email pelapor (Brevo) — server saja, opsional =====
# Dipakai /api/notifikasi/status: email "ada pembaruan" ke pelapor setiap
# admin mengubah status laporan. Kosongkan BREVO_API_KEY untuk mematikan
# fitur ini — perubahan status tetap jalan, hanya emailnya yang dilewati.
# Kunci dari Brevo > SMTP & API > API Keys. Paket gratis ±300 email/hari.
BREVO_API_KEY=your-brevo-api-key
# Alamat pengirim harus sudah diverifikasi di Brevo (Senders, Domains & IPs).
BREVO_SENDER_EMAIL=noreply@example.com
# BREVO_SENDER_NAME=RWP Hutama Karya   # bawaan: APP_NAME
# "true" = Brevo memvalidasi permintaan tanpa benar-benar mengirim (uji coba).
# BREVO_SANDBOX=true
# URL publik aplikasi untuk tautan di email, tanpa garis miring di akhir.
# Di Vercel boleh dikosongkan: memakai VERCEL_PROJECT_PRODUCTION_URL.
APP_URL=http://localhost:3000

# ===== Storage =====
# Bucket privat dokumen kebijakan (PDF) dan berkas korpus asisten.
# Bucket bukti laporan (rwp-evidence) ditetapkan di kode, lihat lib/storage.ts.
POLICY_PDF_BUCKET=policy-docs

# ===== Dev opsional =====
# Alamat perangkat lain di jaringan lokal yang boleh membuka `next dev`.
# NEXT_PUBLIC_DEV_ORIGIN=192.168.0.10
